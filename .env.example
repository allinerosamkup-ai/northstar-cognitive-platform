# Northstar reads this file at startup. The easiest way to fill it in is the
# Settings screen in the app — it writes here for you and can test each key.
# A real environment variable always wins over a value in this file.

# Adding a key is what puts a resident on its real provider. There is no
# separate switch to remember.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Off by default, and worth leaving off: it makes every resident call its
# provider on every project event just to acknowledge it, which multiplies cost
# without adding capability — each request already carries the full context.
LIVE_RESIDENCY=false

PORT=4310
COGNITIVE_DATA_PATH=./data/project-brain.jsonl

# Folder the Files view can browse, attach from, and write to. Nothing outside
# it is readable or writable.
COGNITIVE_WORKSPACE_PATH=.
